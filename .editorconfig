root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml,ts,js,mjs,css,html,cshtml}]
indent_size = 2

[*.cshtml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Complexity budgets. Thresholds live in CodeMetricsConfig.txt. Existing offenders are listed in the
# baseline block at the end of this file, which may only shrink.
[*.cs]
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1506.severity = warning

# Tests name behaviours with underscores and wire many types on purpose.
[*{Tests,IntegrationTests}/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1506.severity = none

# BEGIN complexity baseline (may only shrink: one section per file setting CA1502/CA1506 to none)
[Wayfinder.Umbraco.ReferenceApp/Program.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none
[Wayfinder.Umbraco.Starter/StarterComposer.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none
[Wayfinder.Umbraco/Models/ServiceRequestPageViewModel.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none
[Wayfinder.Umbraco/Services/ServiceRequestStageService.cs]
dotnet_diagnostic.CA1502.severity = none
dotnet_diagnostic.CA1506.severity = none
# END complexity baseline
