<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Compiles Views/** into the assembly as a Razor Class Library, the same way
         Wayfinder.Umbraco ships its own views. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <PackageId>Wayfinder.Umbraco.Starter</PackageId>
    <Title>Wayfinder for Umbraco: starter kit</Title>
    <!-- Released with Wayfinder.Umbraco, always at the same version (package-release.yml checks). -->
    <Version>6.1.0</Version>
    <Authors>Jonny Muir</Authors>
    <Company>Wayfinder</Company>
    <Description>Try Wayfinder on a fresh Umbraco site with no code: a home page, a sample service with a public and a staff queue, demo staff sign-in, and the MCP authoring endpoint wired up so you can design a service in conversation with an AI assistant. For local development only, never install it on a real site.</Description>
    <PackageTags>Umbraco;umbraco-marketplace;ServiceDesign;GDS;Blueprint;Wayfinder;Starter</PackageTags>
    <PackageProjectUrl>https://github.com/jonnymuir/Wayfinder.Umbraco</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/Wayfinder.Umbraco</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>assets/icon-wayfinder-umbraco.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Becomes a Wayfinder.Umbraco package dependency at the same version when packed. -->
    <ProjectReference Include="../Wayfinder.Umbraco/Wayfinder.Umbraco.csproj" />
    <PackageReference Include="Wayfinder.Engine.Mcp" Version="0.25.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Views/**/*.cshtml" />
    <EmbeddedResource Include="service-blueprints/*.yaml" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../assets/icon-wayfinder-umbraco.png" Pack="true" PackagePath="assets/" />
  </ItemGroup>

</Project>
