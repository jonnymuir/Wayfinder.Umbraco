{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "1f6a2c9e-4d7b-4a3f-9e6c-8b2a5d7f1c30",
        "SanitizeTinyMce": true
      },
      "Unattended": {
        "InstallUnattended": true,
        "UpgradeUnattended": true,
        "PackageMigrationsUnattended": true,
        "UnattendedUserName": "Reference App",
        "UnattendedUserEmail": "admin@example.test",
        "UnattendedUserPassword": "Wayfinder123!"
      },
      "Security": {
        "AllowConcurrentLogins": true
      },
      "ModelsBuilder": {
        "ModelsMode": "InMemoryAuto",
        "ModelsNamespace": "Umbraco.Cms.Web.Common.PublishedModels",
        "AcceptUnsafeModelsDirectory": true
      }
    },
    "Automate": {
      "UseNamedConnectionString": "umbracoDbDSN"
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Wayfinder": {
    "SupportSystems": [
      {
        "key": "njf-coaching-standards",
        "displayName": "NJF Coaching Standards",
        "description": "The National Juggling Federation's coaching-standards body. An Umbraco Automate automation on this same site does the work: some logic on the application, an email to the standards officer, a human accredited/provisional/referred decision, then a callback.",
        "endpoint": {
          "url": "https://localhost:44399/umbraco/automate/webhook/6f1c0000-0000-0000-0000-00000000c0de",
          "method": "POST",
          "auth": { "type": "none" },
          "callbackSecretRef": "NJF_STANDARDS_CALLBACK_SECRET"
        },
        "capabilities": [
          {
            "key": "check-coaching-standards",
            "displayName": "Check coaching standards",
            "completionModes": [ "Webhook" ],
            "inputs": [
              { "key": "applicantName", "title": "Applicant name", "valueKind": "String", "format": "field-ref", "required": true },
              { "key": "yearsCoaching", "title": "Years of coaching experience", "valueKind": "Number", "format": "field-ref" },
              { "key": "disclosureReference", "title": "Safeguarding disclosure reference", "valueKind": "String", "format": "field-ref" },
              { "key": "firstAidExpiry", "title": "First-aid certificate expiry", "valueKind": "String", "format": "field-ref" }
            ],
            "outputs": [
              { "key": "coachingStandardsOutcome", "title": "Outcome", "valueKind": "String" },
              { "key": "coachingStandardsNote", "title": "Standards officer's note", "valueKind": "String" }
            ],
            "outcomes": [
              { "key": "accredited", "displayName": "Accredited" },
              { "key": "provisional", "displayName": "Provisional" },
              { "key": "referred", "displayName": "Referred" }
            ]
          }
        ]
      }
    ]
  }
}