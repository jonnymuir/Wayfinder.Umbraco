{
  "definitionKey": "reference-demo",
  "displayName": "Reference demo request",
  "version": 1,
  "description": "Minimal two-actor blueprint seeded by this reference app to exercise both packaged Block Grid blocks: the citizen-facing stage and the caseworker-facing worklist.",
  "initialStage": "apply",
  "requestPolicy": "single",
  "stages": [
    {
      "stageKey": "apply",
      "displayName": "Tell us what you need",
      "queueKey": "citizen",
      "components": [
        {
          "type": "text",
          "fieldKey": "message",
          "label": "What do you need?",
          "required": true
        }
      ],
      "routes": [
        {
          "id": "apply--submit--to-review",
          "target": "to-review",
          "trigger": "submit",
          "label": "Submit",
          "style": "primary"
        }
      ]
    },
    {
      "stageKey": "review",
      "displayName": "Review request",
      "queueKey": "caseworker",
      "components": [
        {
          "type": "summary-list",
          "title": "Request details",
          "children": [
            {
              "type": "text",
              "fieldKey": "message",
              "label": "What do you need?",
              "changeStateKey": "apply"
            }
          ]
        }
      ],
      "routes": [
        {
          "id": "review--approve--post-review",
          "target": "post-review",
          "trigger": "approve",
          "label": "Approve",
          "style": "primary"
        },
        {
          "id": "review--reject--post-review",
          "target": "post-review",
          "trigger": "reject",
          "label": "Reject",
          "style": "destructive"
        }
      ]
    },
    {
      "stageKey": "approved",
      "displayName": "Request approved",
      "stageType": "Confirmation",
      "queueKey": "citizen",
      "components": [
        {
          "type": "panel",
          "heading": "Request approved"
        },
        {
          "type": "body",
          "content": "A caseworker has approved your request."
        }
      ]
    },
    {
      "stageKey": "rejected",
      "displayName": "Request not approved",
      "stageType": "Confirmation",
      "queueKey": "citizen",
      "components": [
        {
          "type": "panel",
          "heading": "Request not approved"
        },
        {
          "type": "body",
          "content": "A caseworker has not approved your request this time."
        }
      ]
    }
  ],
  "queues": [
    { "key": "citizen", "displayName": "Applicant", "actor": "citizen" },
    { "key": "caseworker", "displayName": "Caseworker", "actor": "caseworker" }
  ],
  "gateways": [
    {
      "key": "to-review",
      "displayName": "Hand off to caseworker",
      "gatewayType": "Split",
      "queueKey": "citizen",
      "routes": [
        { "id": "to-review--submit--review", "target": "review", "trigger": "submit" },
        { "id": "to-review--submit--post-review", "target": "post-review", "trigger": "submit" }
      ]
    },
    {
      "key": "post-review",
      "displayName": "Request reviewed",
      "gatewayType": "Join",
      "queueKey": "citizen",
      "routes": [
        { "id": "post-review--approve--approved", "target": "approved", "trigger": "approve" },
        { "id": "post-review--reject--rejected", "target": "rejected", "trigger": "reject" }
      ],
      "waitingContent": "A caseworker is reviewing your request. We'll update this page once a decision is made.",
      "waitingExpectedSeconds": 60,
      "waitingPollIntervalMs": 5000,
      "requiredIncomingQueues": ["citizen", "caseworker"]
    }
  ]
}
