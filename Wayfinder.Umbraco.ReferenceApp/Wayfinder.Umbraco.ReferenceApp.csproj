<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Umbraco's own SDK-shipped ModelsBuilder/media-picker etc. content depends on this. -->
    <UserSecretsId>wayfinder-umbraco-referenceapp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="$(UmbracoVersion)" />
    <!-- Umbraco Automate (MIT) — the worked example of a configuration-only webhook support
         system. Version tracks the Umbraco major; 17.3.0 is the current 17.x line. Only in this
         reference app, never in the Wayfinder.Umbraco package itself. -->
    <PackageReference Include="Umbraco.Automate" Version="17.3.0" />
    <PackageReference Include="Umbraco.Automate.Persistence.Sqlite" Version="17.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectReference, not a NuGet PackageReference — this app exists to prove the package
         works before it's ever published, and to keep proving it afterward. It never ships. -->
    <ProjectReference Include="../Wayfinder.Umbraco/Wayfinder.Umbraco.csproj" />
    <!-- Not one of Wayfinder.Umbraco.csproj's own PackageReferences (that package has no MCP
         opinion of its own) — this app wires the MCP authoring surface itself, the same way
         Wayfinder.ReferenceApp does in the core repo, chaining its own RequireAuthorization()
         onto it (WayfinderUmbracoAuthorizationPolicies.BlueprintsAdmin) instead of leaving it
         anonymous. -->
    <PackageReference Include="Wayfinder.Engine.Mcp" Version="0.9.0" />
    <!-- MapWebhookSupportSystemCallbacks — the inbound half of the config-driven webhook
         support system (Wayfinder.Umbraco itself has no runtime-route opinion, same as MCP). -->
    <PackageReference Include="Wayfinder.Engine.Http" Version="0.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="service-blueprints\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
