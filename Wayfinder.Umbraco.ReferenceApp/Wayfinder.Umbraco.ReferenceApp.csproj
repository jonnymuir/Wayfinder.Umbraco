<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Umbraco's own SDK-shipped ModelsBuilder/media-picker etc. content depends on this. -->
    <UserSecretsId>wayfinder-umbraco-referenceapp</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="$(UmbracoVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectReference, not a NuGet PackageReference — this app exists to prove the package
         works before it's ever published, and to keep proving it afterward. It never ships. -->
    <ProjectReference Include="../Wayfinder.Umbraco/Wayfinder.Umbraco.csproj" />
    <!-- Not one of Wayfinder.Umbraco.csproj's own PackageReferences (that package has no MCP
         opinion of its own) — this app wires the MCP authoring surface itself, the same way
         Wayfinder.ReferenceApp does in the core repo, chaining its own RequireAuthorization()
         onto it (WayfinderUmbracoAuthorizationPolicies.BlueprintsAdmin) instead of leaving it
         anonymous. -->
    <PackageReference Include="Wayfinder.Engine.Mcp" Version="0.7.8" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="service-blueprints\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
