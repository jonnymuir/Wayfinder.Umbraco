@using System.IO
@using System.Text.Encodings.Web
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Extensions
@using Wayfinder.Umbraco.ReferenceApp
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var citizenGrid = Model.Value<BlockGridModel>("citizenArea");
    var caseworkerGrid = Model.Value<BlockGridModel>("caseworkerArea");

    string citizenHtml;
    if (citizenGrid is not null && citizenGrid.Any())
    {
        using var citizenWriter = new StringWriter();
        (await Html.GetBlockGridHtmlAsync(citizenGrid)).WriteTo(citizenWriter, HtmlEncoder.Default);
        citizenHtml = citizenWriter.ToString();
    }
    else
    {
        citizenHtml = "<p class=\"govuk-body\"><em>No citizen-facing block placed yet — add a &quot;Wayfinder Service Request Stage&quot; block in the backoffice.</em></p>";
    }

    string caseworkerHtml;
    if (caseworkerGrid is not null && caseworkerGrid.Any())
    {
        using var caseworkerWriter = new StringWriter();
        (await Html.GetBlockGridHtmlAsync(caseworkerGrid)).WriteTo(caseworkerWriter, HtmlEncoder.Default);
        caseworkerHtml = caseworkerWriter.ToString();
    }
    else
    {
        caseworkerHtml = "<p class=\"govuk-body\"><em>No caseworker-facing block placed yet — add a &quot;Wayfinder Service Request Worklist&quot; block in the backoffice.</em></p>";
    }

    var body = "<h2 class=\"govuk-heading-l\">Citizen area</h2>" + citizenHtml
        + "<h2 class=\"govuk-heading-l\">Caseworker area</h2>" + caseworkerHtml;
}
@Html.Raw(ReferenceAppPageShell.Render("Home", body, Context.User))