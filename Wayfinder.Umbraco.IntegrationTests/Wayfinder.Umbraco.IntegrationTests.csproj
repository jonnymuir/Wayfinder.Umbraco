<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Booted-host integration lane for Wayfinder.Umbraco. Runs in its OWN test process so the
    real Umbraco host (booted via WebApplicationFactory<Program> over Wayfinder.Umbraco.ReferenceApp)
    does not share process-global state — notably Wayfinder's static SupportSystemRegistry, which
    a fast unit test freezes on first read — with Wayfinder.Umbraco.Tests. One shared
    ICollectionFixture boot serves every test class here (a second boot in the same process would
    re-hit that freeze).

    Deliberately NOT Aspire: Wayfinder.Umbraco.AppHost pulls in a Mailpit container for the
    coaching-standards email demo, which an authorization-contract suite never touches. This lane
    is just `dotnet test` — no Docker, no DCP.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="AwesomeAssertions" Version="7.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host under test — WebApplicationFactory<Program> boots this exact project. -->
    <ProjectReference Include="../Wayfinder.Umbraco.ReferenceApp/Wayfinder.Umbraco.ReferenceApp.csproj" />
    <!-- The package whose controllers this suite asserts against. -->
    <ProjectReference Include="../Wayfinder.Umbraco/Wayfinder.Umbraco.csproj" />
  </ItemGroup>

</Project>
