<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="AwesomeAssertions" Version="7.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- Wayfinder.Umbraco references this PrivateAssets="all" (host-resolved at runtime), so it
         doesn't flow transitively — the MCP OAuth client tests compile against it directly.
         Deliberately NOT $(OpenIddictVersion): a plain floor that unifies with whatever
         Umbraco.Cms.Api.Management (transitive, via the Wayfinder.Umbraco project ref) actually
         resolves — that "truth" version is what OpenIddictAssemblyLoadContractTests loads
         Wayfinder.Umbraco.dll against, so a $(OpenIddictVersion) drift above Umbraco's shows up
         as ReflectionTypeLoadException in CI, not a host crash at boot. -->
    <PackageReference Include="OpenIddict.Abstractions" Version="7.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Wayfinder.Umbraco/Wayfinder.Umbraco.csproj" />
  </ItemGroup>

  <!-- The reference app's own committed config + blueprint, linked so a test can assert the two
       actually agree (see ConfiguredSupportSystemBlueprintTests). -->
  <ItemGroup>
    <None Include="../Wayfinder.Umbraco.ReferenceApp/appsettings.json" Link="Fixtures/referenceapp.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Wayfinder.Umbraco.ReferenceApp/service-blueprints/njf-coaching-register.json" Link="Fixtures/njf-coaching-register.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
