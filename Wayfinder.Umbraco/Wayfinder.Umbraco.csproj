<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- wwwroot/dist is gitignored (npm build output) but the default Content glob still picks
         it up here regardless, colliding with the explicit item below (NETSDK1022) — same fix
         as Wayfinder.Editor.csproj: explicit items only, not the SDK's implicit discovery. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <!-- Without this, Views/*.cshtml never actually compile into RazorCompiledItems at all —
         confirmed live: the previous EmbeddedResource-only approach below embedded their raw
         TEXT as a resource blob, but produced zero RazorCompiledItem entries in the assembly,
         so a consuming host's view engine could never find them (silently — no error, "no
         template found"). AddRazorSupportForMvc is what actually makes an Sdk.Web/Sdk.Razor
         library compile and package its views as a real Razor Class Library, discovered
         automatically by any consuming host's ApplicationPartManager with zero host wiring.
         Still needed for the package's own stage-level views (serviceRequestHub.cshtml,
         _Stage-*.cshtml, and the Block Grid partials under Views/Partials/blockgrid/Components) —
         the built-in component/field catalog itself moved
         to Wayfinder.Rendering.GovUk (plain C#, no Razor at all), so ComponentPartialResolver's
         job shrank to just resolving a HOST's own override, if one exists; see that class's own
         remarks for why a host override still can't share a virtual path with anything this
         package owns. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>Wayfinder.Umbraco</PackageId>
    <Title>Wayfinder for Umbraco</Title>
    <Version>1.0.4</Version>
    <Authors>Jonny Muir</Authors>
    <Company>Wayfinder</Company>
    <Description>Umbraco-hosted implementation of Wayfinder service design: a DB-backed, uSync-portable service blueprint store, a backoffice authoring API, and two Block Grid-composable building blocks (a citizen-facing stage journey and a caseworker-facing worklist) for any Umbraco v17+ site. An authoritative in-process engine, real multi-queue support, no multi-tenancy or auth opinions of its own; a host wires its own identity/tenant resolution on top.</Description>
    <!-- umbraco-marketplace is the tag Umbraco's own marketplace scraper looks for on nuget.org
         to auto-list a package — see UmbracoPrism.Core.csproj's own precedent for this
         convention. -->
    <PackageTags>Umbraco;umbraco-marketplace;ServiceDesign;GDS;Blueprint;Wayfinder</PackageTags>
    <PackageProjectUrl>https://github.com/jonnymuir/Wayfinder.Umbraco</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonnymuir/Wayfinder.Umbraco</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>assets/icon-wayfinder-umbraco.png</PackageIcon>
    <!-- MARKETPLACE.md, not README.md: nuget.org's renderer doesn't execute raw HTML (README's
         <picture> dark/light lockup) or resolve relative image paths — see
         scripts/generate-marketplace-readme.mjs, which generates MARKETPLACE.md from README.md
         (same fix Umbraco.Prism already uses for its own nuget.org listing). -->
    <PackageReadmeFile>MARKETPLACE.md</PackageReadmeFile>
    <!-- Umbraco's backoffice package-manifest discovery scans App_Plugins/{name}/umbraco-package.json
         specifically (a legacy convention still honored alongside the new extension-manifest
         system) — see UmbracoPrism.Core.csproj's own override for the precedent this mirrors. -->
    <StaticWebAssetBasePath>App_Plugins/Wayfinder</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="uSync.BackOffice" Version="$(USyncPackageRange)" />
    <!-- Microsoft.OpenApi (used directly in WayfinderManagementApiConfiguration.cs) is left to
         flow transitively from Umbraco.Cms.Api.Management below — see Directory.Build.props for
         why it isn't pinned. -->
    <!-- Wayfinder.Umbraco.Mcp plugs a custom IOpenIddictServerHandler into Umbraco's *own*
         backoffice OpenIddict server (and registers the MCP OAuth client, relaxes dev transport
         security). It must run against exactly the OpenIddict version Umbraco itself resolves —
         PrivateAssets="all" keeps these off the package's dependency graph (the host gets
         OpenIddict from its Umbraco), and the version is an EXACT pin "[$(OpenIddictVersion)]",
         kept in lockstep with $(UmbracoVersion) in Directory.Build.props. Exact (not ">= ") so a
         drift fails `dotnet restore` here (NU1107), not a host at boot — a ">= " pin above
         Umbraco's version once shipped a ReflectionTypeLoadException to every 17.6.x host. -->
    <PackageReference Include="OpenIddict.Abstractions" Version="[$(OpenIddictVersion)]" PrivateAssets="all" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" Version="[$(OpenIddictVersion)]" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="$(UmbracoPackageRange)" />
    <PackageReference Include="Umbraco.Cms.Core" Version="$(UmbracoPackageRange)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoPackageRange)" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="$(UmbracoPackageRange)" />
    <PackageReference Include="Wayfinder" Version="0.9.9" />
    <PackageReference Include="Wayfinder.Editor" Version="0.3.0" />
    <PackageReference Include="Wayfinder.Engine" Version="0.9.9" />
    <PackageReference Include="Wayfinder.Engine.Worklist" Version="0.3.3" />
    <PackageReference Include="Wayfinder.Rendering.GovUk" Version="0.4.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../MARKETPLACE.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../assets/icon-wayfinder-umbraco.png" Pack="true" PackagePath="assets/" />
  </ItemGroup>

  <!-- EnableDefaultContentItems is off (see above), so wwwroot's static web assets need
       explicit items — the manifest Umbraco's backoffice discovers, plus the npm build output
       it points at. -->
  <ItemGroup>
    <Content Include="wwwroot/umbraco-package.json">
      <Pack>true</Pack>
      <PackagePath>staticwebassets/umbraco-package.json</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="wwwroot/dist/**" Exclude="wwwroot/dist/**/*.map">
      <Pack>true</Pack>
      <PackagePath>staticwebassets/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- EnableDefaultContentItems is off (see above), so the SDK's own default Content glob that
       normally picks up Views/**/*.cshtml for Razor compilation needs restoring explicitly too —
       without this, AddRazorSupportForMvc has nothing to compile (confirmed live: RazorGenerate
       shows empty and Content shows zero .cshtml entries until this item exists). -->
  <ItemGroup>
    <Content Include="Views/**/*.cshtml" />
  </ItemGroup>

</Project>
