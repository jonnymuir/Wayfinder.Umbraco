@using Wayfinder.Umbraco.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Wayfinder.Umbraco.Models.ServiceRequestHubViewModel>
@{
    Layout = "~/Views/Shared/Master.cshtml";
    var pageTitle = string.IsNullOrWhiteSpace(Model.Name) ? "My Service Requests" : Model.Name;
}

<div class="wayfinder-service-request-hub">
    <header class="wayfinder-service-request-hub__header">
        <h1 class="wayfinder-service-request-hub__title">@pageTitle</h1>
        <p class="wayfinder-service-request-hub__subtitle">Track and manage your service requests.</p>
    </header>

    @if (Model.ActiveInstances.Any())
    {
        <section class="wayfinder-service-request-hub__section" aria-labelledby="active-heading">
            <h2 id="active-heading" class="wayfinder-service-request-hub__section-title">In Progress</h2>
            @await Html.PartialAsync("~/Views/Partials/_ServiceRequestHub-InstanceList.cshtml", Model.ActiveInstances)
        </section>
    }

    @if (Model.CompletedInstances.Any())
    {
        <section class="wayfinder-service-request-hub__section" aria-labelledby="completed-heading">
            <h2 id="completed-heading" class="wayfinder-service-request-hub__section-title">Completed</h2>
            @await Html.PartialAsync("~/Views/Partials/_ServiceRequestHub-InstanceList.cshtml", Model.CompletedInstances)
        </section>
    }

    @if (!Model.ActiveInstances.Any() && !Model.CompletedInstances.Any())
    {
        <div class="wayfinder-service-request-hub__empty" role="status">
            <p class="govuk-body">You don't have any active service requests yet.</p>
        </div>
    }
</div>
