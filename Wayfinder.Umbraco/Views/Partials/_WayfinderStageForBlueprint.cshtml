@using Wayfinder.Umbraco.Models
@using Wayfinder.Umbraco.Services
@using Wayfinder.Models.ServiceDesign
@model string
@inject ServiceRequestStageService StageService
@inject IServiceProvider Services
@inject Wayfinder.Engine.Abstractions.IProcessManager ProcessManager
@*
    The citizen-facing stage for one blueprint, anywhere a view can render a partial: the
    wayfinderServiceRequestStage block uses it, and a host can render it from its own block or
    template with @await Html.PartialAsync("~/Views/Partials/_WayfinderStageForBlueprint.cshtml", "blueprint-key").
    The model is the blueprint key.
*@
@{
    var blueprintKey = Model;

    // Someone who followed a private link from an email is asked before this browser joins the request.
    if (Services.GetService(typeof(Wayfinder.Umbraco.Visitors.WayfinderPrivateLinks)) is Wayfinder.Umbraco.Visitors.WayfinderPrivateLinks privateLinks
        && await privateLinks.PendingAsync(Context, blueprintKey, ProcessManager.GetDefinition(blueprintKey)?.DisplayName ?? blueprintKey) is { } prompt)
    {
        @await Html.PartialAsync("~/Views/Partials/_WayfinderPrivateLink.cshtml", prompt)
        return;
    }

    var instanceId = Context.Request.Query["instanceId"].ToString();
    var action = Context.Request.Query["action"].ToString();

    var result = await StageService.RenderCurrentAsync(
        Context, blueprintKey,
        string.IsNullOrEmpty(instanceId) ? null : instanceId,
        string.IsNullOrEmpty(action) ? null : action,
        StageFlash.Take(TempData));

    var returnUrl = Context.Request.PathBase + Context.Request.Path;
    var vm = ServiceRequestPageViewModel.FromRenderResult(result, returnUrl);
}
@await Html.PartialAsync("~/Views/Partials/_WayfinderStageRender.cshtml", vm)
