@model Wayfinder.Umbraco.Models.ServiceRequestPageViewModel
@using System.Reflection
@{
    static string? ReadString(object? source, string propertyName)
    {
        var value = source?.GetType().GetProperty(propertyName, BindingFlags.Public | BindingFlags.Instance)?.GetValue(source);
        return value as string;
    }

    static int? ReadInt(object? source, string propertyName)
    {
        var value = source?.GetType().GetProperty(propertyName, BindingFlags.Public | BindingFlags.Instance)?.GetValue(source);
        if (value is int number)
        {
            return number;
        }

        return value as int?;
    }

    static bool? ReadBool(object? source, string propertyName)
    {
        var value = source?.GetType().GetProperty(propertyName, BindingFlags.Public | BindingFlags.Instance)?.GetValue(source);
        if (value is bool flag)
        {
            return flag;
        }

        return value as bool?;
    }

    static string FormatWaitLabel(int seconds)
    {
        if (seconds < 60)
        {
            return $"This usually takes about {seconds} seconds.";
        }

        if (seconds < 120)
        {
            return "This usually takes about 1 minute.";
        }

        if (seconds < 3600)
        {
            return $"This usually takes about {seconds / 60} minutes.";
        }

        var hours = seconds / 3600;
        return $"This usually takes about {hours} hour{(hours > 1 ? "s" : string.Empty)}.";
    }

    var waitingComponent = Model.Components.FirstOrDefault(component =>
        string.Equals(component.Type, "waiting", StringComparison.OrdinalIgnoreCase));

    var message = ReadString(waitingComponent, "Message")
        ?? waitingComponent?.Content
        ?? "We're processing your request. Please do not close this page.";

    var expectedWaitSeconds = ReadInt(waitingComponent, "ExpectedWaitSeconds")
        ?? 0;

    var pollIntervalMs = ReadInt(waitingComponent, "PollIntervalMs")
        ?? Model.PollAfterMs
        ?? 5000;

    var allowDefer = ReadBool(waitingComponent, "AllowDefer")
        ?? false;

    var deferMessage = ReadString(waitingComponent, "DeferMessage")
        ?? "You can leave this page and return to your applications later. Your progress has been saved.";

    var hasWaitingUi = waitingComponent is not null;
    var waitLabel = expectedWaitSeconds > 0 ? FormatWaitLabel(expectedWaitSeconds) : null;

    // The shared wayfinder-poll.js (Wayfinder.Rendering.GovUk >= 0.4.2) polls this URL and
    // reloads the page on a {"changed": true} response — see ServiceRequestPollController.
    // Built here, not in the script, so the script stays route-agnostic. Razor HTML-encodes
    // the "&" separators into the attribute; the browser decodes them back on read.
    var pollUrl = $"/api/wayfinder/workflow/poll?blueprintKey={Uri.EscapeDataString(Model.BlueprintKey ?? string.Empty)}"
        + $"&instanceId={Uri.EscapeDataString(Model.InstanceId ?? string.Empty)}"
        + $"&knownStateVersion={Model.StateVersion}";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@Model.StateDisplayName</h1>

        @foreach (var component in Model.Components)
        {
            if (string.Equals(component.Type, "waiting", StringComparison.OrdinalIgnoreCase))
            {
                <div class="govuk-notification-banner" role="region" aria-labelledby="wayfinder-waiting-message" data-component-type="waiting">
                    <div class="govuk-notification-banner__header">
                        <h2 class="govuk-notification-banner__title" id="wayfinder-waiting-message">Information</h2>
                    </div>
                    <div class="govuk-notification-banner__content">
                        <p class="govuk-body">@message</p>
                        @if (!string.IsNullOrEmpty(waitLabel))
                        {
                            <p class="govuk-body">@waitLabel</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <wayfinder-component component="@component"
                                 errors="@Model.FieldErrors"
                                 values="@Model.FormValues"
                                 return-url="@Model.ReturnUrl"
                                 instance-id="@Model.InstanceId"
                                 state-version="@Model.StateVersion"
                                 blueprint-key="@Model.BlueprintKey"
                                 nonce="@Model.Nonce" />
            }
        }

        @if (hasWaitingUi && waitingComponent is null)
        {
            <div class="govuk-notification-banner" role="region" aria-labelledby="wayfinder-waiting-message">
                <div class="govuk-notification-banner__header">
                    <h2 class="govuk-notification-banner__title" id="wayfinder-waiting-message">Information</h2>
                </div>
                <div class="govuk-notification-banner__content">
                    <p class="govuk-body">@message</p>
                    @if (!string.IsNullOrEmpty(waitLabel))
                    {
                        <p class="govuk-body">@waitLabel</p>
                    }
                </div>
            </div>
        }

        @if (hasWaitingUi)
        {
            <div role="status" aria-live="polite" aria-atomic="true" id="wayfinder-poll-status" class="govuk-visually-hidden"></div>

            <div id="wayfinder-waiting-data"
                 data-wayfinder-poll-url="@pollUrl"
                 data-wayfinder-poll-interval-ms="@pollIntervalMs"
                 data-wayfinder-poll-status-id="wayfinder-poll-status"
                 hidden>
            </div>

            @if (allowDefer)
            {
                <details class="govuk-details">
                    <summary class="govuk-details__summary">
                        <span class="govuk-details__summary-text">Need to leave this page?</span>
                    </summary>
                    <div class="govuk-details__text">
                        <p class="govuk-body">@deferMessage</p>
                        <p class="govuk-body">
                            <a href="/my-workflows" class="govuk-link">Go to My Applications</a>
                        </p>
                    </div>
                </details>
            }
        }
    </div>
</div>

@if (hasWaitingUi)
{
    <script src="/_content/Wayfinder.Rendering.GovUk/js/wayfinder-poll.js" defer></script>
}
