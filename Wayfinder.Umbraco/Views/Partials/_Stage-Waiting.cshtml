@model Wayfinder.Umbraco.Models.ServiceRequestPageViewModel
@{
    // The waiting component renders through <wayfinder-component> like every other component: the shared
    // Wayfinder.Rendering.GovUk markup says what the join's waitingPace allows, and a site can still restyle
    // it with its own Views/Partials/Components/_Component-Waiting.cshtml.
    var hasWaitingUi = Model.Components.Any(component =>
        string.Equals(component.Type, "waiting", StringComparison.OrdinalIgnoreCase));

    var pollIntervalMs = Model.Components
        .FirstOrDefault(component => string.Equals(component.Type, "waiting", StringComparison.OrdinalIgnoreCase))?.PollIntervalMs
        ?? Model.PollAfterMs
        ?? 5000;

    // The shared wayfinder-poll.js polls this URL and reloads the page on a {"changed": true} response, see
    // ServiceRequestPollController. Built here, not in the script, so the script stays route-agnostic.
    var pollUrl = $"/api/wayfinder/workflow/poll?blueprintKey={Uri.EscapeDataString(Model.BlueprintKey ?? string.Empty)}"
        + $"&instanceId={Uri.EscapeDataString(Model.InstanceId ?? string.Empty)}"
        + $"&knownStateVersion={Model.StateVersion}";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@Model.StateDisplayName</h1>

        @foreach (var component in Model.Components)
        {
            <wayfinder-component component="@component"
                             errors="@Model.FieldErrors"
                             values="@Model.FormValues"
                             return-url="@Model.ReturnUrl"
                             instance-id="@Model.InstanceId"
                             state-version="@Model.StateVersion"
                             blueprint-key="@Model.BlueprintKey"
                             nonce="@Model.Nonce" />
        }

        @if (hasWaitingUi)
        {
            <div role="status" aria-live="polite" aria-atomic="true" id="wayfinder-poll-status" class="govuk-visually-hidden"></div>

            <div id="wayfinder-waiting-data"
                 data-wayfinder-poll-url="@pollUrl"
                 data-wayfinder-poll-interval-ms="@pollIntervalMs"
                 data-wayfinder-poll-status-id="wayfinder-poll-status"
                 hidden>
            </div>
        }
    </div>
</div>

@if (hasWaitingUi)
{
    <script src="/_content/Wayfinder.Rendering.GovUk/js/wayfinder-waiting.js" defer></script>
    <script src="/_content/Wayfinder.Rendering.GovUk/js/wayfinder-poll.js" defer></script>
}
