@model Wayfinder.Umbraco.Models.ServiceRequestPageViewModel

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        @foreach (var component in Model.Components)
        {
            <wayfinder-component component="@component"
                             errors="@Model.FieldErrors"
                             values="@Model.FormValues"
                             return-url="@Model.ReturnUrl"
                             instance-id="@Model.InstanceId"
                             state-version="@Model.StateVersion"
                             blueprint-key="@Model.BlueprintKey"
                             nonce="@Model.Nonce" />
        }

        @{
            // A Confirmation state has no outgoing routes, so under instancePolicy "single" this
            // same instance is what every future visit resumes (deliberately — see
            // WorkflowRuntimeEngine.GetCurrent's "single" fallthrough, so a visitor who already
            // submitted keeps seeing their real confirmation, not a silently-reset blank form).
            // "Start again" is the explicit, visitor-initiated way past that: it goes through the
            // engine's GetCurrentOrManualRestart, which only honours action=start-new when the
            // blueprint itself declares allowManualRestart — a blueprint that hasn't opted in must
            // never show a link that would either do nothing or invite duplicate submissions, so
            // the link is gated here (Model.AllowManualRestart), not just its server-side handling.
            var startAgainUrl = $"{Model.ReturnUrl}?action=start-new";
        }
        <div class="govuk-button-group">
            @if (Model.AvailableActions.Any())
            {
                @foreach (var action in Model.AvailableActions)
                {
                    <a href="/" class="govuk-button govuk-button--secondary" data-module="govuk-button">@action.Label</a>
                }
            }
            @if (Model.AllowManualRestart)
            {
                <a href="@startAgainUrl" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-wayfinder-start-again>Start again</a>
            }
            <a href="/" class="govuk-link">Return to home</a>
        </div>

    </div>
</div>
