@using Microsoft.AspNetCore.Mvc.ViewEngines
@model Wayfinder.Umbraco.Models.ServiceRequestPageViewModel
@inject ICompositeViewEngine ViewEngine
@{
    if (Model.HasError)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.ErrorMessage</li>
                </ul>
            </div>
        </div>
        return;
    }

    if (Model.ShowInstancePicker)
    {
        <h2 class="stage-page__title">@Model.StateDisplayName</h2>
        @await Html.PartialAsync("~/Views/Partials/_ServiceRequestHub-InstancePicker.cshtml", Model)
        return;
    }

    var shell = Wayfinder.Umbraco.Models.ServiceRequestRenderShellResolver.ResolveShell(
        Model.Components,
        Model.StepType,
        Model.Components.Any(c => string.Equals(c.Type, "waiting", StringComparison.OrdinalIgnoreCase)),
        Model.AvailableActions.Any());

    var partialName = shell switch
    {
        "question" => "_Stage-Question",
        "check-answers" => "_Stage-Review",
        "confirmation" => "_Stage-Completion",
        "status-timeline" => "_Stage-StatusTimeline",
        "task-list" => "_Stage-TaskList",
        "waiting" => "_Stage-Waiting",
        _ => $"_Stage-{shell}"
    };
    var partialPath = $"~/Views/Partials/{partialName}.cshtml";
    var viewResult = ViewEngine.GetView(null, partialPath, false);
}
<div class="stage-page">
    @if (viewResult.Success)
    {
        if (partialName == "_Stage-Question")
        {
            <h2 class="stage-page__title">@Model.StateDisplayName</h2>
        }
        @await Html.PartialAsync(partialName, Model)

        @* Scripts that enhance markup any stage shell can render (a map tile on a confirmation page, a date
           that starts on today, a preview of the photo just chosen), so they load here rather than in one shell's partial. Both ship as static web
           assets of Wayfinder.Rendering.GovUk, so a host needs no wiring. They come after the markup they
           act on. *@
        @if (Model.NeedsLocationScript)
        {
            <script type="module" src="/_content/Wayfinder.Rendering.GovUk/location-picker/wayfinder-location-picker.js"></script>
        }

        @if (Model.HasImageFileField)
        {
            <script src="/_content/Wayfinder.Rendering.GovUk/js/wayfinder-file-preview.js"></script>
        }

        @if (Model.HasDeviceClockDefault)
        {
            <script src="/_content/Wayfinder.Rendering.GovUk/js/wayfinder-device-clock.js"></script>
        }
    }
    else
    {
        <h2 class="stage-page__title">@Model.StateDisplayName</h2>
        <div class="stage-alert stage-alert--warn">
            <p>No template found for stage shell: <code>@shell</code></p>
        </div>
    }
</div>
