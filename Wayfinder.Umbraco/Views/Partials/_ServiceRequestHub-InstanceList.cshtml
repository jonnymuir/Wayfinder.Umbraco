@using Wayfinder.Umbraco.Models
@model IReadOnlyList<ServiceRequestViewModel>
@inject Wayfinder.Umbraco.Services.WayfinderDisplayTime DisplayTime

<ul class="wayfinder-instance-list" role="list">
    @foreach (var instance in Model)
    {
        <li class="wayfinder-instance-card"
            data-blueprint-key="@instance.Summary.BlueprintKey"
            data-current-state="@instance.Summary.CurrentStateKey">
            <div class="wayfinder-instance-card__body">
                <h3 class="wayfinder-instance-card__title">@instance.Summary.BlueprintDisplayName</h3>
                <p class="wayfinder-instance-card__status">
                    <span class="wayfinder-instance-card__state-badge">@instance.Summary.CurrentStateDisplayName</span>
                </p>
                <p class="wayfinder-instance-card__meta">
                    Started <time datetime="@DisplayTime.Format(instance.Summary.CreatedAt, "yyyy-MM-dd")">
                        @DisplayTime.Format(instance.Summary.CreatedAt, "d MMM yyyy")
                    </time>
                    @if (instance.Summary.LastUpdatedAt != instance.Summary.CreatedAt)
                    {
                        <span> &middot; Updated <time datetime="@DisplayTime.Format(instance.Summary.LastUpdatedAt, "yyyy-MM-dd")">
                            @DisplayTime.Format(instance.Summary.LastUpdatedAt, "d MMM yyyy")
                        </time></span>
                    }
                </p>
            </div>
            <div class="wayfinder-instance-card__actions">
                <a href="@instance.ResumeUrl"
                   class="wayfinder-button @(instance.Summary.CanContinue ? "wayfinder-button--primary" : "wayfinder-button--secondary")">
                    @(instance.Summary.CanContinue ? "Continue" : "View")
                </a>
            </div>
        </li>
    }
</ul>
