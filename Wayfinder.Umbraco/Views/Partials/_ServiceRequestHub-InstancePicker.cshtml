@model Wayfinder.Umbraco.Models.ServiceRequestPageViewModel

<div class="wayfinder-instance-picker" role="region" aria-label="Resume or start a new workflow">
    <h2 class="wayfinder-instance-picker__title">You have an existing request</h2>
    <p class="wayfinder-instance-picker__description">
        Would you like to continue your existing @Model.WorkflowDisplayName request
        or start a new one?
    </p>
    <div class="wayfinder-instance-picker__actions">
        <a href="?action=resume" class="wayfinder-button wayfinder-button--primary">Continue existing request</a>
        <a href="?action=start-new" class="wayfinder-button wayfinder-button--secondary">Start a new request</a>
    </div>
</div>
