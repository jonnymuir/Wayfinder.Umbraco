@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@inject IPublishedValueFallback PublishedValueFallback
@* The caseworker worklist block: the editor-configured page size, then the shared worklist view. *@
@{
    var configuredPageSizeText = Model.Content.Value<string>(PublishedValueFallback, "pageSize");
    var configuredPageSize = int.TryParse(configuredPageSizeText, out var parsed) && parsed > 0 ? parsed : 20;
}
@await Html.PartialAsync("~/Views/Partials/_WayfinderWorklistForPage.cshtml", configuredPageSize)
