@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@using Wayfinder.Engine.Worklist
@using Wayfinder.Umbraco.Controllers
@using Wayfinder.Umbraco.Models
@using Wayfinder.Umbraco.Services
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@inject ServiceRequestStageService StageService
@inject ServiceRequestWorklistService WorklistService
@inject IPublishedValueFallback PublishedValueFallback
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var pageUrl = Context.Request.PathBase + Context.Request.Path;
    var instanceId = Context.Request.Query["instanceId"].ToString();
    var noLongerInQueue = false;

    if (!string.IsNullOrEmpty(instanceId))
    {
        // Reviewing one item — same stage-rendering pipeline the stage block itself uses.
        // ReturnUrl must carry this item's own ?instanceId=/&blueprintKey= query string, not the
        // bare listing path pageUrl already is (Context.Request.Path drops it) — otherwise every
        // Advance() from here (a correction's resubmit, an accept, ...) PRGs the caseworker back
        // to the listing instead of back to the item they were actually working on. Found live:
        // a real Playwright walkthrough resubmitting a corrected bulk-data-review file landed back
        // on the queue instead of the item's own wait screen.
        var blueprintKey = Context.Request.Query["blueprintKey"].ToString();
        var itemUrl = $"{pageUrl}{Context.Request.QueryString}";
        var result = await StageService.RenderCurrentAsync(Context, blueprintKey, instanceId, action: null);

        // The one PRG outcome that isn't a "wait, resume here" case: a *final* Advance (approve/
        // reject, or anything else that moves the item out of every queue this actor can act on)
        // leaves ReturnUrl pointing at an instance this actor can no longer access at all — every
        // ACCESS_DENIED the engine raises here means exactly that for a link the worklist itself
        // generated (see ProcessManagerEngine's own ACCESS_DENIED call sites: this actor never had
        // an unrelated reason to be shown someone else's instanceId). Falling through to the
        // listing below, with a banner explaining why, beats a dead-end "There is a problem" box
        // for what is actually a normal, expected outcome of finishing the item. Found live: Casey
        // approving a request in the reference app landed on exactly this dead end.
        noLongerInQueue = result.Envelope.ResponseState == "error"
            && result.Envelope.Problems.Any(p => p.Code == "ACCESS_DENIED");

        if (!noLongerInQueue)
        {
            var vm = ServiceRequestPageViewModel.FromRenderResult(result, itemUrl);
            <p class="govuk-body"><a href="@pageUrl" class="govuk-link">&larr; Back to worklist</a></p>
            @await Html.PartialAsync("~/Views/Partials/_WayfinderStageRender.cshtml", vm)
            return;
        }
    }

    // The block's own editor-configured page size is the default; a paginated nav link (built by
    // WorklistRenderer.RenderWorklistBody, which bakes the current size into every page link)
    // overrides it via the query string, exactly as ParseWorklistQuery's own pageSize ?? default
    // fallback expects.
    var configuredPageSizeText = Model.Content.Value<string>(PublishedValueFallback, "pageSize");
    var configuredPageSize = int.TryParse(configuredPageSizeText, out var parsedConfiguredPageSize) && parsedConfiguredPageSize > 0
        ? parsedConfiguredPageSize
        : 20;

    // StringValues' implicit array conversion is annotated string?[] (each element nullable);
    // ParseWorklistQuery wants string[]? — the per-element Select(s => s!) forgives that
    // annotation, safe because ASP.NET's query parser never actually puts a null string into
    // the collection.
    var (statuses, selectedStatuses, sort, pageIndex, pageSize) = WorklistRenderer.ParseWorklistQuery(
        status: Context.Request.Query["status"].Count > 0 ? Context.Request.Query["status"].Select(s => s!).ToArray() : null,
        sort: Context.Request.Query["sort"],
        page: int.TryParse(Context.Request.Query["page"], out var parsedPage) ? parsedPage : null,
        pageSize: int.TryParse(Context.Request.Query["pageSize"], out var parsedPageSize) ? parsedPageSize : null,
        statusFilterApplied: Context.Request.Query["statusFilterApplied"].Count > 0 ? Context.Request.Query["statusFilterApplied"].ToString() : null,
        defaultPageSize: configuredPageSize);

    var searchText = Context.Request.Query["q"].ToString();
    var envelope = WorklistService.GetWorklist(
        Context, statuses, sort, string.IsNullOrEmpty(searchText) ? null : searchText, pageIndex, pageSize);

    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    var body = WorklistRenderer.RenderWorklistBody(
        listUrl: pageUrl,
        itemUrlPrefix: WayfinderWorklistSurfaceController.ItemUrlPrefix,
        pageTitle: null, // this Umbraco content page already renders its own heading
        envelope: envelope,
        selectedStatuses: selectedStatuses,
        parsedSort: sort,
        q: string.IsNullOrEmpty(searchText) ? null : searchText,
        pageIndex: pageIndex,
        size: pageSize,
        antiforgeryToken: antiforgeryToken,
        emptyStateMessage: "No service requests match the current filters");
}
@if (noLongerInQueue)
{
    <div class="govuk-notification-banner" role="region" aria-labelledby="wayfinder-worklist-notification-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="wayfinder-worklist-notification-title">Important</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">That item is no longer in your queue — it's likely already been actioned, or picked up by someone else.</p>
        </div>
    </div>
}
@Html.Raw(body)
