@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem>
@inject IPublishedValueFallback PublishedValueFallback
@{
    var blueprintKey = Model.Content.Value<string>(PublishedValueFallback, "blueprintKey") ?? string.Empty;

    if (string.IsNullOrWhiteSpace(blueprintKey))
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary" role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>No blueprint key configured on this Wayfinder Service Request Stage block.</li>
                </ul>
            </div>
        </div>
        return;
    }
}
@await Html.PartialAsync("~/Views/Partials/_WayfinderStageForBlueprint.cshtml", blueprintKey)
