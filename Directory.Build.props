<Project>
  <PropertyGroup>
    <UmbracoVersion>17.6.2</UmbracoVersion>
    <!-- Microsoft.OpenApi is deliberately NOT pinned in this repo: it flows transitively from
         Umbraco.Cms.Api.Management ($(UmbracoVersion)) at the version Umbraco itself requires
         (17.6.x → 2.9.0+, which clears GHSA-v5pm-xwqc-g5wc, the OpenAPI-parsing resource-exhaustion
         advisory). A hand-maintained pin here would risk holding a version *below* Umbraco's own,
         which then isn't on disk in a real host — 2.7.5 was confirmed live to throw
         FileNotFoundException at startup against an Umbraco 17.5.3 host that shipped 2.4.1. Only
         re-pin to jump *ahead* of Umbraco for a fix it hasn't picked up yet, PrivateAssets="all". -->

  </PropertyGroup>

  <!-- The existing /// XML doc comments are thorough but never shipped to consumers because no
       project set this. Stage 1: ship what already exists without blocking the build on the
       ~70% of public members that aren't documented yet (CS1591) — see docs backlog for filling
       those in and dropping this suppression on Wayfinder.Umbraco specifically. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
