<Project>
  <PropertyGroup>
    <UmbracoVersion>17.5.3</UmbracoVersion>
    <!-- Must match whatever Umbraco.Cms.Api.Management ($(UmbracoVersion)) itself references — a
         higher version wins assembly-conflict resolution at build time but isn't actually present
         at runtime in a host app, since Umbraco's own dependency is what's really on disk
         (confirmed live: 2.7.5 throws FileNotFoundException at startup against a real Umbraco
         17.5.3 host, which ships 2.4.1). Stated once here so every csproj that needs to compile
         against it can only ever agree. 2.4.1 carries a known high-severity advisory
         (GHSA-v5pm-xwqc-g5wc, a resource-exhaustion issue in OpenAPI document parsing); accepted
         here because nothing in this repo parses an untrusted OpenAPI document at runtime with
         this dependency — it's compile-time-only (PrivateAssets="all") to satisfy Umbraco's own
         transitive API surface. Revisit once Umbraco.Cms.Api.Management itself moves off 2.4.1. -->
    <MicrosoftOpenApiVersion>2.4.1</MicrosoftOpenApiVersion>
  </PropertyGroup>

  <!-- The existing /// XML doc comments are thorough but never shipped to consumers because no
       project set this. Stage 1: ship what already exists without blocking the build on the
       ~70% of public members that aren't documented yet (CS1591) — see docs backlog for filling
       those in and dropping this suppression on Wayfinder.Umbraco specifically. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
